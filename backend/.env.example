# Copy to backend/.env and adjust. Never commit the real .env file.

# development | production. Production refuses to start without a real SECRET_KEY and CORS_ORIGINS.
ENVIRONMENT=development

# Secret used to sign JWT access tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Primary database (PostgreSQL). If unreachable the app falls back to SQLite (unless ALLOW_SQLITE_FALLBACK=false).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/supplyguard
SQLITE_FALLBACK_URL=sqlite:///./supplyguard.db
ALLOW_SQLITE_FALLBACK=true

# Demo data: seed on first start; RESET_DEMO_DATA=true drops and rebuilds all tables on every start.
SEED_DEMO_DATA=true
RESET_DEMO_DATA=false

# Interactive API docs at /docs (default: on in development, off in production)
ENABLE_DOCS=true

# Comma separated list of allowed browser origins (your Netlify site in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
