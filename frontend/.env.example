# Copy to frontend/.env.local for local overrides (ignored by git).

# Base URL of the backend WITHOUT /api. Leave empty in local development to use the Vite proxy.
# Production (Netlify): set this to your deployed API, e.g. https://supplyguard-api.onrender.com
VITE_API_BASE_URL=

# Show the one-click demo account buttons on the login page (default: true)
VITE_SHOW_DEMO_ACCOUNTS=true
